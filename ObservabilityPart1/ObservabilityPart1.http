@ObservabilityPart1_HostAddress = http://localhost:5176

# Phase 1: fast, by primary key
GET {{ObservabilityPart1_HostAddress}}/phase1/patients/1
Accept: application/json

###

# Phase 2: slow, unindexed lookup + fake 2s external call
GET {{ObservabilityPart1_HostAddress}}/phase2/patients/1
Accept: application/json

###

# Phase 3: same code as phase 2 (observe the console)
GET {{ObservabilityPart1_HostAddress}}/phase3/patients/1
Accept: application/json

###

# Phase 4: instrumented with correlation ID + stopwatches
GET {{ObservabilityPart1_HostAddress}}/phase4/patients/10
Accept: application/json

